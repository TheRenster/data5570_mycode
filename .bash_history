#!/bin/bash
# Function to check if a command exists
command_exists() {     command -v "$1" >/dev/null 2>&1; }
if ! command_exists python3; then     echo "Python 3 is not installed. Installing Python 3...";     sudo apt update;     sudo apt install -y python3 python3-full; else     echo "Python 3 is already installed."; fi
echo "Creating a virtual environment..."
python3 -m venv myvenv
chmod +x myvenv/bin/activate
echo "Activating the virtual environment..."
source myvenv/bin/activate
echo "Installing Django..."
python3 -m pip install Django
if command_exists django-admin; then     echo "Django has been installed successfully!"; else     echo "There was an issue installing Django. Please check the logs above."; fi
django-admin startproject myproject
cd myproject
python manage.py createsuperuser
python3 manage.py makemigrations
python3 manage.py migrate
python3 manage.py runserver 0.0.0.0:8000
python3 manage.py startapp customers
